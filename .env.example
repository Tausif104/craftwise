# =============================================================================
# CraftWise — environment variables
#
# Copy to `.env` for local development, and add the same keys in Vercel under
# Project → Settings → Environment Variables.
#
# Never commit the filled-in `.env`; it is gitignored on purpose.
# =============================================================================

# --- Database (required) -----------------------------------------------------
# Postgres connection string. On Neon use the POOLED host (…-pooler…) so
# serverless functions do not exhaust connections.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Authentication (required) -----------------------------------------------
# Generate with:  openssl rand -base64 32
# Sign-in fails and existing sessions are invalidated if this changes.
AUTH_SECRET=""

# --- Site ---------------------------------------------------------------------
# Public origin, no trailing slash. Used in outgoing email links and metadata.
# On Vercel set this to the production domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Media uploads (required for the media library and article editor) --------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Outgoing email (required for lead notifications and replies) ------------
# Gmail app password, not the account password — 2FA must be enabled.
# https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
MAIL_FROM=""
MAIL_FROM_NAME="CraftWise"

# Where new website enquiries are announced. Falls back to MAIL_FROM if unset.
SALES_INBOX=""

# --- Analytics (optional) -----------------------------------------------------
# Measurement ID powers on-site tracking; the property ID plus a service
# account are what the admin panel needs to report traffic.
NEXT_PUBLIC_GA_ID=""
GA4_PROPERTY_ID=""
GA4_SERVICE_ACCOUNT_JSON=""

# --- Booking (optional) -------------------------------------------------------
# Used by the {{bookingLink}} variable in email templates.
NEXT_PUBLIC_BOOKING_URL=""
CALENDLY_TOKEN=""
